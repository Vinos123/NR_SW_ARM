{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PUSCH link (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-debug/pusch_cli.exe",
      "args": [
        "link",
        "inf"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${env:UCRT64_ROOT}/bin/gdb.exe",
      "preLaunchTask": "build",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:UCRT64_ROOT}/bin;${env:PATH}"
        }
      ],
      "setupCommands": [
        {
          "text": "-enable-pretty-printing"
        }
      ]
    }
  ]
}
