include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PuschModules.cmake")

# 中文：同一课程声明既可被根工程调用，也可作为独立工程入口。
# English: One lesson declaration serves root and standalone projects.
function(pusch_add_lesson number)
  set(solution "lesson_${number}_solution")
  set(exercise "lesson_${number}_exercise")
  add_executable(${solution} main.cc solution.cc)
  target_compile_features(${solution} PRIVATE cxx_std_20)
  pusch_link_modules(${solution} ${ARGN})
  if(PUSCH_BUILD_EXERCISES)
    if(PUSCH_STANDALONE_LESSON)
      add_executable(${exercise} main.cc exercise.cc)
    else()
      add_executable(${exercise} EXCLUDE_FROM_ALL main.cc exercise.cc)
    endif()
    target_compile_features(${exercise} PRIVATE cxx_std_20)
    pusch_link_modules(${exercise} ${ARGN})
  endif()
  if(PUSCH_BUILD_TESTS)
    add_test(NAME ${solution} COMMAND ${solution})
    set_tests_properties(${solution} PROPERTIES SKIP_RETURN_CODE 77)
  endif()
  if(number STREQUAL "23" OR number STREQUAL "24")
    target_sources(${solution} PRIVATE kernel_solution.cc)
    if(PUSCH_BUILD_EXERCISES)
      target_sources(${exercise} PRIVATE kernel_exercise.cc)
    endif()
    if(number STREQUAL "23")
      set(option PUSCH_ENABLE_AVX512)
      set(flag "-mavx512f")
    else()
      set(option PUSCH_ENABLE_SVE)
      set(flag "-march=armv8-a+sve")
    endif()
    if(${option})
      pusch_check_simd_arch(${option})
      set_source_files_properties(kernel_solution.cc kernel_exercise.cc
        PROPERTIES COMPILE_OPTIONS "${flag}")
      target_compile_definitions(${solution} PRIVATE PUSCH_LESSON_SIMD)
      if(PUSCH_BUILD_EXERCISES)
        target_compile_definitions(${exercise} PRIVATE PUSCH_LESSON_SIMD)
      endif()
    endif()
  endif()
endfunction()
